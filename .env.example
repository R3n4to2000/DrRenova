# Renovamed — variáveis de ambiente (exemplo, sem valores reais)

# Conexão de runtime da aplicação — role com privilégios restritos (RLS ativo,
# sem UPDATE/DELETE em audit_logs, sem DELETE em entidades de retenção).
DATABASE_URL="postgresql://app_runtime:CHANGE_ME@localhost:5432/renovamed?schema=public"

# Conexão usada SOMENTE para rodar migrations — role com privilégio de DDL.
# Nunca usar esta URL no código de aplicação em runtime.
MIGRATE_DATABASE_URL="postgresql://app_migrator:CHANGE_ME@localhost:5432/renovamed?schema=public"

# Chave AES-256-GCM em base64 (32 bytes) para cifrar CPF/whatsapp em repouso.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY="CHANGE_ME_32_BYTES_BASE64"

# Segredo para HMAC-SHA256 usado no hash determinístico de CPF (unicidade/busca).
FIELD_HASH_SECRET="CHANGE_ME_LONG_RANDOM_STRING"

# Segredo do mecanismo de sessão assinada (placeholder pré-Supabase Auth —
# ver docs/PENDENCIAS.md). Assina/verifica o token que carrega userId/role/
# mfaVerified. Quando o Supabase Auth real for integrado, este mecanismo é
# substituído pela verificação do JWT do Supabase; o contrato posterior
# (claims verificadas -> AppContext) não muda.
SESSION_TOKEN_SECRET="CHANGE_ME_LONG_RANDOM_STRING"

# Modo de autenticação: "development" (dev-login local) ou "supabase" (real).
# Produção SEMPRE força "supabase" independentemente do valor aqui — ver
# src/lib/http-context.ts::getAuthMode(). Staging deve usar "supabase".
AUTH_MODE="development"

# Segredo do projeto Supabase (Project Settings > API > JWT Secret) — usado
# para verificar OFFLINE a assinatura dos tokens emitidos pelo Supabase Auth.
# Só necessário quando AUTH_MODE=supabase. Nunca commitar o valor real.
SUPABASE_JWT_SECRET="CHANGE_ME_SUPABASE_PROJECT_JWT_SECRET"

# Supabase (Auth + Storage) — preenchido quando a integração real for feita.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
