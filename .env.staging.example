# Renovamed — Variáveis de ambiente para STAGING
#
# Diferenças obrigatórias em relação a .env.example (desenvolvimento local):
# - AUTH_MODE deve ser "supabase" (nunca "development") — dev-login retorna
#   403 automaticamente quando AUTH_MODE=supabase, mesmo se alguém tentar
#   habilitá-lo por engano.
# - Todos os segredos devem vir do provedor de secrets do ambiente de
#   staging (ex.: Vercel/Fly/Render env vars, ou um vault), NUNCA deste
#   arquivo com valores reais — isto é só um template.
# - O seed de staging (scripts/seed-staging.mjs) só insere dados 100%
#   fictícios — nunca rodar contra um banco com dados de pacientes reais.

DATABASE_URL="CHANGE_ME_STAGING_RUNTIME_CONNECTION_STRING"
MIGRATE_DATABASE_URL="CHANGE_ME_STAGING_MIGRATOR_CONNECTION_STRING"

FIELD_ENCRYPTION_KEY="CHANGE_ME_STAGING_32_BYTE_KEY_BASE64"
FIELD_HASH_SECRET="CHANGE_ME_STAGING_HMAC_SECRET"
SESSION_TOKEN_SECRET="CHANGE_ME_STAGING_SESSION_SECRET_UNUSED_WHEN_AUTH_MODE_SUPABASE"

AUTH_MODE="supabase"
SUPABASE_JWT_SECRET="CHANGE_ME_STAGING_SUPABASE_PROJECT_JWT_SECRET"
SUPABASE_URL="CHANGE_ME_STAGING_SUPABASE_PROJECT_URL"
SUPABASE_ANON_KEY="CHANGE_ME_STAGING_SUPABASE_ANON_KEY"

NODE_ENV="production"
